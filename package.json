{
  "name": "cms-playground-monorepo",
  "private": true,
  "description": "Multi-CMS WebAssembly Playground CLI powered by @php-wasm",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test packages/*/test/*.test.mjs tests/*.test.mjs",
    "start:joomla": "node packages/cli/bin/cms-playground.mjs start --joomla",
    "start:wp": "node packages/cli/bin/cms-playground.mjs start --wp"
  }
}

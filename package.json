{
  "name": "cms-playground-monorepo",
  "private": true,
  "description": "Multi-CMS WebAssembly Playground CLI powered by @php-wasm",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:site": "node scripts/build-site.mjs",
    "test": "node --test packages/*/test/*.test.mjs tests/*.test.mjs",
    "test:unit": "node --test packages/*/test/*.test.mjs",
    "test:docs": "node --test tests/docs.test.mjs",
    "test:website": "node --test tests/website.test.mjs",
    "test:e2e": "node --test --test-timeout=240000 tests/e2e/*.e2e.test.mjs",
    "test:e2e:cli": "node --test tests/e2e/cli.e2e.test.mjs",
    "test:e2e:joomla": "node --test --test-timeout=240000 tests/e2e/joomla.e2e.test.mjs",
    "test:e2e:wp": "node --test --test-timeout=240000 tests/e2e/wordpress.e2e.test.mjs",
    "start:joomla": "node packages/cli/bin/cms-playground.mjs start --joomla",
    "start:wp": "node packages/cli/bin/cms-playground.mjs start --wp"
  }
}

{
  "name": "@cms-playground/cli",
  "version": "0.1.0",
  "description": "Run Joomla, WordPress, Drupal, TYPO3, and Kirby locally in WebAssembly with zero setup",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "files": [
    "bin",
    "src",
    "skills"
  ],
  "engines": {
    "node": ">=24.18.0",
    "npm": ">=11.16.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fellyph/cms-playground.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/fellyph/cms-playground/issues"
  },
  "homepage": "https://github.com/fellyph/cms-playground#readme",
  "bin": {
    "cms-playground": "bin/cms-playground.mjs"
  },
  "exports": {
    ".": "./src/cli.js"
  },
  "dependencies": {
    "@cms-playground/core": "0.1.0",
    "@cms-playground/joomla": "0.1.0",
    "@cms-playground/wordpress": "0.1.0",
    "@cms-playground/drupal": "0.1.0",
    "@cms-playground/typo3": "0.1.0",
    "@cms-playground/kirby": "0.1.0"
  }
}
